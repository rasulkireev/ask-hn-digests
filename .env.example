DEBUG=on
ENVIRONMENT=dev

SECRET_KEY="super-secret-key"

ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8006,http://localhost:8006

DATABASE_URL=postgres://ask_hn_digest:ask_hn_digest@db:5432/ask_hn_digest
REDIS_URL=redis://:ask_hn_digest@redis:6379/0

AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=ask_hn_digest
AWS_SECRET_ACCESS_KEY=ask_hn_digest

SENTRY_DSN=
MAILGUN_API_KEY=
POSTHOG_API_KEY=
BUTTONDOWN_API_KEY=



# Get these values here: https://mjml.io/api/
MJML_SECRET=...
MJML_APPLICATION_ID=...

# AI runs through Pydantic AI and OpenRouter.
# Content model names use OpenRouter model IDs.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:8006
OPENROUTER_APP_TITLE="Ask HN Digest"
AI_CONTENT_MODEL=google/gemini-2.5-flash
AI_EMBEDDING_MODEL=openai/text-embedding-3-small

LOGFIRE_TOKEN=
LOGFIRE_CONSOLE_SHOW_PROJECT_LINK=False
